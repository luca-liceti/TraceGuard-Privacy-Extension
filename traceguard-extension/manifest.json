{
    "manifest_version": 3,
    "name": "TraceGuard Privacy Extension",
    "version": "1.3.0",
    "key": "",
    "description": "Real-time privacy scoring and protection.",
    "icons": {
        "16": "src/assets/icons/icon-16.png",
        "48": "src/assets/icons/icon-48.png",
        "128": "src/assets/icons/icon-128.png"
    },
    "action": {
        "default_popup": "src/popup/index.html"
    },
    "background": {
        "service_worker": "src/background/index.ts",
        "type": "module"
    },
    "side_panel": {
        "default_path": "src/sidepanel/index.html"
    },
    "permissions": [
        "storage",
        "unlimitedStorage",
        "sidePanel",
        "tabs",
        "notifications",
        "alarms",
        "webRequest"
    ],
    "host_permissions": [
        "*://*/*"
    ],

    "content_scripts": [
        {
            "matches": [
                "*://*/*"
            ],
            "js": [
                "src/content/index.ts"
            ],
            "run_at": "document_idle"
        }
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://api.tosdr.org https://raw.githubusercontent.com;"
    }
}
