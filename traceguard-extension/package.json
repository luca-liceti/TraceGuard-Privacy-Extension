    "react-resizable-panels": "^4.12.1",
    "react-router-dom": "^7.9.6",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^3.4.18",
    "tailwindcss-animate": "^1.0.7",
