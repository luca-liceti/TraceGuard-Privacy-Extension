{
  "name": "traceguard-extension",
  "version": "1.3.1",
  "description": "Real-time privacy scoring and protection Chrome extension with WSS/UPS metrics",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/sync-version.mjs",
    "build": "npm run typecheck && npm run build:phishlist && npm run build:tosdr && vite build",
    "build:phishlist": "node scripts/build-phishlist.js",
    "sign:phishlist": "node scripts/sign-phishlist.js",
    "upload:store": "chrome-webstore-upload upload --source traceguard-extension-v$npm_package_version.zip",
    "generate:threat-keys": "node scripts/generate-threat-keys.js",
    "build:tosdr": "node scripts/build-tosdr.js",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "chrome-extension",
    "privacy",
    "security",
    "tracker-detection",
    "manifest-v3"
  ],
  "author": "Luca Liceti",
  "license": "AGPL-3.0",
  "type": "commonjs",
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@crxjs/vite-plugin": "2.7.1",
    "@dnd-kit/core": "^6.3.1",
